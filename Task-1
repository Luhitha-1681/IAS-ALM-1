server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

server.bind((HOST, PORT))
server.listen(1)

print("======================================")
print("       SDES SERVER")
print("======================================")
print("Server started...")
print("Waiting for client...")

connection, address = server.accept()

print("Client connected:", address)

# Receive file size first
data = connection.recv(4)

file_size = struct.unpack("!I", data)[0]

print("File size received:", file_size, "bytes")

# Receive encrypted file
ciphertext = b""

while len(ciphertext) < file_size:
    packet = connection.recv(min(4096, file_size - len(ciphertext)))

    if not packet:
        break

    ciphertext += packet

print("\nEncrypted file received successfully!")

# Decrypt
plaintext = bytearray()

for byte in ciphertext:
    plaintext.append(decrypt_byte(byte, KEY))

# Display ciphertext
print("\n========== CIPHERTEXT ==========")

print(
    " ".join(f"{byte:02X}" for byte in ciphertext[:100])
)

print("\n(Showing first 100 bytes of ciphertext)")

# Display plaintext
print("\n========== PLAINTEXT ==========")

print(plaintext[:500].decode("utf-8", errors="replace"))

print("\n(Showing first part of plaintext)")

# Save decrypted file
with open("decrypted_1MB.txt", "wb") as file:
    file.write(plaintext)

print("\nDecrypted file saved as: decrypted_1MB.txt")

