import socket
import struct

# ---------------- SDES ----------------

P10 = [3, 5, 2, 7, 4, 10, 1, 9, 8, 6]
P8 = [6, 3, 7, 4, 8, 5, 10, 9]
IP = [2, 6, 3, 1, 4, 8, 5, 7]
IP_INV = [4, 1, 3, 5, 7, 2, 8, 6]
EP = [4, 1, 2, 3, 2, 3, 4, 1]
P4 = [2, 4, 3, 1]

S0 = [
    [1, 0, 3, 2],
    [3, 2, 1, 0],
    [0, 2, 1, 3],
    [3, 1, 3, 2]
]

S1 = [
    [0, 1, 2, 3],
    [2, 0, 1, 3],
    [3, 0, 1, 0],
    [2, 1, 0, 3]
]


def permute(bits, pattern):
    return [bits[i - 1] for i in pattern]


def left_shift(bits, count):
    return bits[count:] + bits[:count]


def xor(a, b):
    return [x ^ y for x, y in zip(a, b)]


def generate_keys(key):
    key = [int(x) for x in key]

    p10 = permute(key, P10)

    left = p10[:5]
    right = p10[5:]

    left = left_shift(left, 1)
    right = left_shift(right, 1)

    k1 = permute(left + right, P8)

    left = left_shift(left, 2)
    right = left_shift(right, 2)

    k2 = permute(left + right, P8)

    return k1, k2


def sbox_lookup(bits, sbox):
    row = bits[0] * 2 + bits[3]
    col = bits[1] * 2 + bits[2]

    value = sbox[row][col]

    return [(value >> 1) & 1, value & 1]


def fk(bits, key):
    left = bits[:4]
    right = bits[4:]

    expanded = permute(right, EP)
    xored = xor(expanded, key)

    left4 = xored[:4]
    right4 = xored[4:]

    s0_output = sbox_lookup(left4, S0)
    s1_output = sbox_lookup(right4, S1)

    p4 = permute(s0_output + s1_output, P4)

    new_left = xor(left, p4)

    return new_left + right


def switch(bits):
    return bits[4:] + bits[:4]


def decrypt_byte(byte, key):
    bits = [(byte >> (7 - i)) & 1 for i in range(8)]

    k1, k2 = generate_keys(key)

    bits = permute(bits, IP)
    bits = fk(bits, k2)
    bits = switch(bits)
    bits = fk(bits, k1)
    bits = permute(bits, IP_INV)

    result = 0

    for bit in bits:
        result = (result << 1) | bit

    return result


# ---------------- CLIENT ----------------

HOST = "127.0.0.1"
PORT = 5001

KEY = "1010000010"

print("======================================")
print("       SDES CLIENT - TASK 2")
print("======================================")

client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

print("Connecting to server...")

client.connect((HOST, PORT))

print("Connected to server!")

# Receive file size
data = client.recv(4)

file_size = struct.unpack("!I", data)[0]

print("Encrypted file size:", file_size, "bytes")

# Receive ciphertext
ciphertext = b""

while len(ciphertext) < file_size:

    packet = client.recv(min(4096, file_size - len(ciphertext)))

    if not packet:
        break

    ciphertext += packet

print("\nEncrypted file received successfully!")

# Display ciphertext
print("\n========== CIPHERTEXT ==========")

print(" ".join(f"{byte:02X}" for byte in ciphertext[:100]))

print("\n(Showing first 100 bytes of ciphertext)")

# Decrypt
plaintext = bytearray()

for byte in ciphertext:
    plaintext.append(decrypt_byte(byte, KEY))

# Display plaintext
print("\n========== PLAINTEXT ==========")

print(plaintext[:500].decode("utf-8", errors="replace"))

print("\n(Showing first part of plaintext)")

# Save decrypted file
with open("decrypted_10KB.txt", "wb") as file:
    file.write(plaintext)

print("\nDecrypted file saved as: decrypted_10KB.txt")

client.close()

print("\nClient finished.")



